{
  "name": "@org/server-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@org/server"
    ],
    "targets": {
      "e2e": {
        "command": "jest --passWithNoTests",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@org/server:build",
          "@org/server:serve"
        ],
        "options": {
          "cwd": "apps/server-e2e"
        }
      }
    }
  }
}
