{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@saas-kit/admin",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "tags": ["type:app", "scope:admin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next build --webpack"
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next dev -p 3001"
      },
      "readyWhen": {
        "command": "node -e \"require('@nx/next/ready-check').waitForDevServer()\"",
        "interval": 1000
      }
    },
    "start": {
      "continuous": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next start -p 3001"
      },
      "readyWhen": {
        "command": "node -e \"require('@nx/next/ready-check').waitForDevServer()\"",
        "interval": 1000
      }
    }
  }
}
